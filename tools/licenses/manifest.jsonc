      "group": "grammars",
      "name": "Kotlin queries",
      "version": "for tree-sitter-kotlin-ng v1.1.0",
      "spdx": "GPL-3.0-or-later",
      "copyright": "Copyright (C) 2026 Eyed",
      "url": "https://github.com/tree-sitter-grammars/tree-sitter-kotlin",
      "licenseFiles": ["licenses/GPL-3.0.txt"],
      "note": "Written here against the grammar's node names, because tree-sitter-kotlin-ng ships no queries of its own."
    },

    // ── Downloaded after installation ────────────────────────────────────
    // Mirrors app/src/main/assets/solana/toolchain/manifest.json, which is the
    // thing that actually downloads them. If a version moves there and not
    // here, the two disagree — the generator cannot check that for us because
    // the manifest has no licence field, so it is checked by eye at release.
    {
      "id": "downloaded/debian",
      "group": "downloaded",
      "name": "Debian userland",
      "version": "stable-slim, rolling",
      "spdx": "A collection of works under many licences",
      "copyright": "Copyright (C) the Debian contributors and upstream authors",
      "url": "https://www.debian.org",
      "licenseFiles": [],
      "note": "Debian's own stable-slim container image, fetched from Debian's registry and verified against its digest. Every package in it carries its own copyright file at /usr/share/doc/<package>/copyright inside the installed rootfs, which is where its licence is to be read."
    },
    {
      "id": "downloaded/rustup",
      "group": "downloaded",
