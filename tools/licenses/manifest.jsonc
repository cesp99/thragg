      "url": "https://github.com/anza-xyz/platform-tools",
      "licenseFiles": ["licenses/Apache-2.0.txt", "licenses/LLVM-exception.txt"],
      "note": "An LLVM with the SBF backend, and a Rust toolchain to drive it. The bundled LLVM is Apache-2.0 with the LLVM exception."
    },
    {
