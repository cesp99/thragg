      "group": "grammars",
      "name": "XML queries",
      "version": "v0.7.0",
      "spdx": "MIT",
      "copyright": "Copyright (c) Amaan Qureshi",
      "url": "https://github.com/tree-sitter-grammars/tree-sitter-xml",
      "licenseFiles": ["licenses/MIT.txt"],
      "note": "queries/xml/highlights.scm, with markup.* and @error renamed."
    },
    {
      "id": "grammars/tree-sitter-scss-queries",
      "group": "grammars",
      "name": "SCSS queries",
      "version": "v1.0.0",
      "spdx": "MIT AND GPL-3.0-or-later",
      "copyright": "Copyright (c) Amaan Qureshi; Copyright (C) Zed Industries, Inc.",
      "url": "https://github.com/tree-sitter-grammars/tree-sitter-scss",
      "licenseFiles": ["licenses/MIT.txt", "licenses/GPL-3.0.txt"],
      "note": "Upstream's queries/highlights.scm, filled in from Zed's css/highlights.scm for what SCSS shares with CSS — so this one file is genuinely both."
