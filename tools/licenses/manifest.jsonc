      "licenseFiles": ["licenses/MIT.txt"],
      "note": "The one grammar vendored as generated C rather than taken from crates.io: parser.c and scanner.c live at core/crates/tree-sitter-dockerfile/grammar/ with upstream's LICENSE beside them. queries/highlights.scm came with it, @none dropped."
    },
    {
      "id": "grammars/tree-sitter-make-queries",
      "group": "grammars",
      "name": "Make queries",
      "version": "v1.1.1",
      "spdx": "MIT",
