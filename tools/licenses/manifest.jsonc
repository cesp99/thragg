      "version": "v2.7.3",
      "spdx": "not yet stated",
      "copyright": "Copyright (C) 2026 Eyed",
      "url": "https://github.com/aploide/spettro",
      "licenseFiles": [],
      "note": "Eyed's own release artefact, fetched by default as part of Setup. Its licence has not been settled and this row says so rather than guessing: a stated licence that turns out to be wrong is worse than an honest blank. It is on the release checklist in docs/LICENSING.md."
    },
    {
      "id": "downloaded/apt",
      "group": "downloaded",
      "name": "Build tools (via apt)",
      "version": "",
      "spdx": "Each package under its own terms",
      "copyright": "Copyright (C) the Debian contributors and upstream authors",
      "url": "https://www.debian.org",
      "licenseFiles": [],
      "note": "The compiler and headers the two on-device crate builds need, installed by apt from Debian's own archives. Same answer as the userland: each package's copyright file is inside the rootfs."
    },
    {
      "id": "downloaded/cargo-build-sbf",
      "group": "downloaded",
      "name": "cargo-build-sbf",
      "version": "4.2.0",
      "spdx": "Apache-2.0",
      "copyright": "Copyright (c) Anza Technology, Inc.",
      "url": "https://crates.io/crates/solana-cargo-build-sbf",
      "licenseFiles": ["licenses/Apache-2.0.txt"],
      "note": "Built on device from crates.io."
    },
    {
      "id": "downloaded/anchor",
      "group": "downloaded",
      "name": "Anchor CLI",
      "version": "1.1.2",
      "spdx": "Apache-2.0",
      "copyright": "Copyright (c) the Anchor contributors",
      "url": "https://github.com/coral-xyz/anchor",
      "licenseFiles": ["licenses/Apache-2.0.txt"],
      "note": "Built on device from crates.io. Anchor is also the shape the project scaffolds imitate — solana/templates/SolanaTemplates.kt writes an Anchor.toml, a crate manifest, a lib.rs and a test in the form `anchor init` produces, using Anchor's own placeholder program id."
    }
  ],

  // Rows the generated Rust closure cannot answer for itself. Four vendored
  // Zed crates declare no `license` in their Cargo.toml, which makes an SPDX
  // scanner report four unlicensed packages inside libseekercore.so. The
  // information is on disk — each carries a LICENSE-APACHE or a LICENSE-GPL —
  // and core/vendor/VENDOR.md is correct about all four. Upstream Zed has the
  // same gap. The real fix is four one-line additions to those Cargo.toml
  // files, marked SEEKER PATCH; until someone can do that without colliding
  // with a build in flight, this is where the answer lives, and the generator
  // FAILS if a crate has no licence and no entry here.
  "rustLicenceOverrides": {
    "gpui_shared_string": "Apache-2.0",
    "gpui_util": "Apache-2.0",
    "grammars": "GPL-3.0-or-later",
    "language_core": "GPL-3.0-or-later"
  },

  // Who holds copyright in a package that lives inside this tree, keyed by
  // directory. Used ONLY when the package ships no copyright line of its own —
  // and thirty of the vendored Zed crates do not, because their only licence
  // file is the bare GPL, whose own copyright line belongs to the FSF and says
  // nothing about who wrote the crate. Both holders below are recorded facts
  // (core/vendor/VENDOR.md, docs/THIRD_PARTY.md), not inferences.
  "rustPathCopyrights": {
    "core/vendor": "Copyright (C) Zed Industries, Inc.",
    "core/crates": "Copyright (C) 2026 Eyed"
  },

  // Maven groups the generator is willing to resolve a licence for, and where
  // that answer comes from. A POM's <licenses> block is the authority, but
  // Gradle only downloads POMs when something asks for them, and asking turns
  // a notices build into a network build — which is exactly what must not
  // happen on the machine that ships a release. So the licence is decided by
  // group here, from the POMs as read at the time, and the generator FAILS on
  // a group that is not in this table. Adding a dependency from a new
  // publisher therefore cannot quietly produce an incomplete screen.
  "mavenLicences": {
    "androidx":            { "spdx": "Apache-2.0", "copyright": "Copyright (C) The Android Open Source Project", "url": "https://developer.android.com/jetpack/androidx" },
    "com.google":          { "spdx": "Apache-2.0", "copyright": "Copyright (C) Google LLC", "url": "https://developers.google.com" },
    "org.jetbrains":       { "spdx": "Apache-2.0", "copyright": "Copyright (C) JetBrains s.r.o. and Kotlin Programming Language contributors", "url": "https://github.com/JetBrains/kotlin" },
    "org.jspecify":        { "spdx": "Apache-2.0", "copyright": "Copyright (C) The JSpecify Authors", "url": "https://jspecify.dev" },
    "org.checkerframework": { "spdx": "MIT", "copyright": "Copyright (c) 2004-present the Checker Framework developers", "url": "https://checkerframework.org" },
    "com.squareup":        { "spdx": "Apache-2.0", "copyright": "Copyright (C) Square, Inc.", "url": "https://square.github.io" },
    // The chain layer (docs/SOLANA.md): Mobile Wallet Adapter and its
    // web3-core primitives, both Solana Mobile's, read from the POMs of
    // mobile-wallet-adapter-clientlib-ktx 2.2.0 and web3-solana 0.3.1.
    "com.solanamobile":    { "spdx": "Apache-2.0", "copyright": "Copyright (c) 2022 Solana Mobile Inc.", "url": "https://github.com/solana-mobile/mobile-wallet-adapter" },
    // web3-solana's three small Kotlin-multiplatform helpers, one author.
    // kborsh and multimult declare Apache-2.0 in their POMs; salkt declares
    // MIT. This table is keyed by group and the three share one, so the row
    // carries both — an AND ships both texts, and both do apply to the set.
    "io.github.funkatronics": { "spdx": "Apache-2.0 AND MIT", "copyright": "Copyright (c) 2024 Marco Martinez", "url": "https://github.com/Funkatronics" },
    // web3-core's byte buffer (Kotlin multiplatform), Apache-2.0 per the POM.
    "com.ditchoom":        { "spdx": "Apache-2.0", "copyright": "Copyright (C) Rahul Behera", "url": "https://github.com/DitchOoM/buffer" },
    // The websocket the MWA local association runs over.
    "com.neovisionaries":  { "spdx": "Apache-2.0", "copyright": "Copyright (C) 2015-2017 Neo Visionaries Inc.", "url": "https://github.com/TakahikoKawasaki/nv-websocket-client" },
    // Ed25519 for the deploy key. CC0: the LICENSE.txt is the bare public
    // domain dedication and names nobody, so the holder is the project's own
    // description of itself.
    "net.i2p.crypto":      { "spdx": "CC0-1.0", "copyright": "Copyright (C) str4d and the I2P project", "url": "https://github.com/str4d/ed25519-java" }
  }
}
