      "version": "1.29.0",
      "spdx": "MIT OR Apache-2.0",
      "copyright": "Copyright (c) 2016 The Rust Project Developers",
      "url": "https://github.com/rust-lang/rustup",
      "licenseFiles": ["licenses/MIT.txt", "licenses/Apache-2.0.txt"]
    },
    {
      "id": "downloaded/platform-tools",
      "group": "downloaded",
      "name": "SBF platform-tools",
      "version": "v1.57",
      "spdx": "Apache-2.0 AND Apache-2.0 WITH LLVM-exception",
