<?xml version="1.0" encoding="utf-8"?>
<!--
  **Not Zed's mark any more.** This file used to hold Zed Industries' ai_zed
  glyph — their 'Z' logo — imported by tools/import-zed-icons.py. A logo is a
  trademark, and GPLv3 s7(e) is explicit that the licence conveys no trademark
  rights, so shipping another company's identity inside this app's navigation
  was wrong regardless of how the artwork was licensed.

  The replacement is ic_ui_agent.xml, drawn here. The only reason this file
  still exists is that ui/workspace/Docks.kt:37 still names R.drawable.ic_ui_ai_zed,
  and Docks.kt belongs to the panel switcher that is being removed; deleting
  the drawable ahead of its last caller would just break the build. So the
  artwork is gone now and the resource name goes with Docks.kt.

  Until then this draws the same sparkle ic_ui_agent does, so nothing on
  screen regresses. When Docks.kt goes, delete this file — the Kotlin should
  point at ic_ui_agent, never at a name with "zed" in it.

  `ai_zed.svg` has also been dropped from tools/import-zed-icons.py, which no
  longer imports UI glyphs at all, so a re-import cannot bring the mark back.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="16dp"
    android:viewportWidth="16"
    android:viewportHeight="16">
    <path
        android:pathData="M6.4,1.4 Q6.4,6.4 11.4,6.4 Q6.4,6.4 6.4,11.4 Q6.4,6.4 1.4,6.4 Q6.4,6.4 6.4,1.4 Z"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M12.3,9.7 Q12.3,12.3 14.9,12.3 Q12.3,12.3 12.3,14.9 Q12.3,12.3 9.7,12.3 Q12.3,12.3 12.3,9.7 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
