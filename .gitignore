# Gradle output of the vendored Android modules (kept out of the vendor
# directories themselves so they stay byte-identical to upstream)
/vendor/*/build

# Rust
/core/target
core/**/target

# Generated by cargo-ndk (cargoNdkBuild Gradle task) — libthraggcore.so and
# anything else the engine build drops in. libproot_exec.so is the exception:
# it is a committed binary (tools/build-proot.sh reproduces it, but no CI
# machine rebuilds it), and it lives here because there is one source set now
# that the `full` flavour is gone. The three lines have to be spelled this way:
# ignoring the directory itself would make the `!` unreachable, so ignore the
# contents, keep the ABI directories, then keep proot inside them.
/app/src/main/jniLibs/**
!/app/src/main/jniLibs/*/
!/app/src/main/jniLibs/*/libproot_exec.so

# Claude Code's own working directory (worktrees, session state)
/.claude/

# Local agent documentation — never push (see agent-docs/README note)
/agent-docs/
/CLAUDE.md
/AGENTS.md

/app/build
.spettro/

# local experiment scratch (rootfs, toolchain tarballs, zig)
.lab/

# Python bytecode from tools/
__pycache__/
*.pyc
